fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="38626A41" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">Eu apliquei uma correção que evita que o </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>React</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> "rebente" ao tentar </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>renderizar</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> erros complexos vindos do servidor.</w:t></w:r></w:p><w:p w14:paraId="32930B38" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"/><w:p w14:paraId="4E222162" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">  O que foi corrigido:</w:t></w:r></w:p><w:p w14:paraId="0E6795BB" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">   1. Tratamento de Erros: Agora, o sistema verifica se o erro vindo da API é uma frase simples ou um objeto detalhado do </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>FastAPI</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="36E7D457" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">   2. Conversão para Texto: Se for um objeto (como um erro de validação), o sistema extrai apenas a mensagem amigável (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>ex</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">: "Field </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>required</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>") para mostrar ao utilizador, em vez de tentar mostrar o objeto inteiro.</w:t></w:r></w:p><w:p w14:paraId="76C9EA4A" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">   3. Ficheiros afetados: Admin.js e NewEpisode.js.</w:t></w:r></w:p><w:p w14:paraId="3B2E0D2C" w14:textId="77777777" w:rsidR="00E861AA" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"/><w:p w14:paraId="74EC8396" w14:textId="70BC2739" w:rsidR="00A141D2" w:rsidRDefault="00E861AA" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">  Podes tentar criar o utilizador novamente. Se houver algum erro nos dados (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>ex</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>: falta preencher um campo), verás agora uma mensagem de erro em texto e a aplicação continuará a funcionar normalmente.</w:t></w:r></w:p><w:p w14:paraId="4C9F06F7" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00E861AA"/><w:p w14:paraId="6FB076AE" w14:textId="6D77E221" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00E861AA"><w:r><w:t xml:space="preserve">Não dava </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>pra</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> criar utentes</w:t></w:r></w:p><w:p w14:paraId="4B2D84EF" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t>Implementei uma solução integrada na página de Novo Episódio. Agora, o fluxo de trabalho é muito mais natural:</w:t></w:r></w:p><w:p w14:paraId="2C51B12C" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"/><w:p w14:paraId="5506B17C" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t xml:space="preserve">  O que mudou:</w:t></w:r></w:p><w:p w14:paraId="7CD3CD57" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t xml:space="preserve">   1. Formulário de Utente Integrado: Se o utente não estiver na lista, podes clicar no botão "+ Novo Utente".</w:t></w:r></w:p><w:p w14:paraId="64798700" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t xml:space="preserve">   2. Criação Rápida: Abre-se um formulário simples para preencheres o Nº SNS, Idade, Sexo e Localidade.</w:t></w:r></w:p><w:p w14:paraId="253D09B5" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t xml:space="preserve">   3. Seleção Automática: Assim que gravas o novo utente, a lista de episódios é atualizada e o novo utente fica automaticamente selecionado para que possas terminar a admissão sem perder tempo.</w:t></w:r></w:p><w:p w14:paraId="31AA1E26" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t xml:space="preserve">   4. Interface em Grelha: Dividi a página em duas colunas (1. Identificação do Utente | 2. Detalhes do Episódio) para ficar mais organizado visualmente.</w:t></w:r></w:p><w:p w14:paraId="665376E3" w14:textId="77777777" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"/><w:p w14:paraId="2DF8401E" w14:textId="2B5F91C8" w:rsidR="00923602" w:rsidRDefault="00923602" w:rsidP="00923602"><w:r><w:t xml:space="preserve">  Podes testar agora: </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Dashboard</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Segoe UI Symbol" w:hAnsi="Segoe UI Symbol" w:cs="Segoe UI Symbol"/></w:rPr><w:t>➔</w:t></w:r><w:r><w:t xml:space="preserve"> Novo Epis</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Aptos" w:hAnsi="Aptos" w:cs="Aptos"/></w:rPr><w:t>ó</w:t></w:r><w:r><w:t xml:space="preserve">dio. Se o paciente for novo, regista-o </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Aptos" w:hAnsi="Aptos" w:cs="Aptos"/></w:rPr><w:t>à</w:t></w:r><w:r><w:t xml:space="preserve"> esquerda e depois finaliza a admiss</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Aptos" w:hAnsi="Aptos" w:cs="Aptos"/></w:rPr><w:t>ã</w:t></w:r><w:r><w:t xml:space="preserve">o </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Aptos" w:hAnsi="Aptos" w:cs="Aptos"/></w:rPr><w:t>à</w:t></w:r><w:r><w:t xml:space="preserve"> direita.</w:t></w:r></w:p><w:p w14:paraId="1F9400F3" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="00923602"/><w:p w14:paraId="0094656D" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="006D6A13"><w:r><w:t>Implementei uma solução integrada na página de Novo Episódio. Agora, o fluxo de trabalho é muito mais natural:</w:t></w:r></w:p><w:p w14:paraId="5803C17D" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="006D6A13"/><w:p w14:paraId="2322CFC6" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="006D6A13"><w:r><w:t xml:space="preserve">  O que mudou:</w:t></w:r></w:p><w:p w14:paraId="0989AB6F" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="006D6A13"><w:r><w:t xml:space="preserve">   1. Formulário de Utente Integrado: Se o utente não estiver na lista, podes clicar no botão "+ Novo Utente".</w:t></w:r></w:p><w:p w14:paraId="01828643" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="006D6A13"><w:r><w:t xml:space="preserve">   2. Criação Rápida: Abre-se um formulário simples para preencheres o Nº SNS, Idade, Sexo e Localidade.</w:t></w:r></w:p><w:p w14:paraId="07657004" w14:textId="77777777" w:rsidR="006D6A13" w:rsidRDefault="006D6A13" w:rsidP="006D6A13"><w:r><w:t xml:space="preserve">   3. Seleção Automática: 