End"/><w:r><w:t xml:space="preserve"> que possas ter no teu PC.</w:t></w:r></w:p><w:sectPr w:rsidR="00A141D2"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1417" w:right="1701" w:bottom="1417" w:left="1701" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>