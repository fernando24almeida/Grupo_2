EDD" w14:textId="77777777" w:rsidR="009B088D" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">       * </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Bcrypt</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">: Algoritmo de </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>hashing</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> para proteção de palavras-passe.</w:t></w:r></w:p><w:p w14:paraId="3544721D" w14:textId="77777777" w:rsidR="009B088D" w:rsidRDefault="009B088D" w:rsidP="006219B3"/><w:p w14:paraId="2B27051A" w14:textId="22647AFF" w:rsidR="00795208" w:rsidRDefault="00795208" w:rsidP="006219B3"><w:r><w:t>Docker Desktop</w:t></w:r></w:p><w:p w14:paraId="5E49FB6B" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"/><w:p w14:paraId="0882C176" w14:textId="77777777" w:rsidR="009B088D" w:rsidRDefault="009B088D"><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="573F221E" w14:textId="45A93C80" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">  4. O Problema a tratar na Tarefa de IA</w:t></w:r></w:p><w:p w14:paraId="2C0CC878" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  Embora a base da aplicação esteja concluída, a tarefa de Inteligência Artificial (IA) foca-se num problema crítico na gestão hospitalar: A Eficiência Operacional e o Tempo de Espera.</w:t></w:r></w:p><w:p w14:paraId="017368D5" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"/><w:p w14:paraId="43896090" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  O Problema:</w:t></w:r></w:p><w:p w14:paraId="084A3C19" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  O congestionamento nas urgências hospitalares é frequentemente causado pela dificuldade em prever a afluência de pacientes e pela demora na triagem manual.</w:t></w:r></w:p><w:p w14:paraId="22F04A79" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"/><w:p w14:paraId="7765D10E" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  A Aplicabilidade da IA:</w:t></w:r></w:p><w:p w14:paraId="181202C5" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  A tarefa de IA neste projeto visa processar os dados históricos acumulados pelo sistema (episódios, triagens e sintomas) para resolver dois desafios principais:</w:t></w:r></w:p><w:p w14:paraId="0600FCA3" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">   1. Previsão de Prioridade (Triagem Inteligente): Apoiar o enfermeiro na definição da prioridade de um paciente com base nos sintomas e histórico, reduzindo o erro humano.</w:t></w:r></w:p><w:p w14:paraId="6EE8AE1D" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">   2. Previsão de Tempos de Espera: Estimar, em tempo real, quanto tempo um utente terá de esperar com base no fluxo atual de pacientes e na disponibilidade de recursos (médicos e enfermeiros ativos).</w:t></w:r></w:p><w:p w14:paraId="6F6C7183" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"/><w:p w14:paraId="2E4BACD8" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  Objetivo Final da IA:</w:t></w:r></w:p><w:p w14:paraId="2832B6DB" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  Transformar dados passivos em conhecimento preditivo, permitindo aos administradores hospitalares tomarem decisões proativas (como reforçar equipas em horários de pico previstos) e melhorarem a experiência do utente.</w:t></w:r></w:p><w:p w14:paraId="3C9DC7F9" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"/><w:p w14:paraId="0C0D8230" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  ---</w:t></w:r></w:p><w:p w14:paraId="7D482009" w14:textId="77777777" w:rsidR="006219B3" w:rsidRDefault="006219B3" w:rsidP="006219B3"/><w:p w14:paraId="0B3F4F02" w14:textId="5301E6BD" w:rsidR="00A141D2" w:rsidRDefault="006219B3" w:rsidP="006219B3"><w:r><w:t xml:space="preserve">  Este relatório demonstra que a fundação técnica (a base) está sólida, segura e pronta para receber as funcionalidades avançadas de Inteligência Artificial que darão o valor diferencial ao projeto.</w:t></w:r></w:p><w:sectPr w:rsidR="00A141D2"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1417" w:right="1701" w:bottom="1417" w:left="1701" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>